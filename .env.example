# Copy the values you need into the shell that starts AgentBridge.
AGENTBRIDGE_PORT=8787
AGENTBRIDGE_HOST=0.0.0.0
AGENTBRIDGE_MACHINE_NAME=My-PC

# Semicolon-separated alias=absolute-path entries. Phones only see aliases.
AGENTBRIDGE_PROJECTS=agentbridge=D:\codex_project\手机远程操控agent

# Optional. Required for Tailscale/ZeroTier direct mode or when a reverse proxy/HTTPS tunnel is used.
# Tailscale example: http://100.101.102.103:8787
# ZeroTier example:  http://10.147.20.15:8787 (the managed IP shown at my.zerotier.com)
# Cloudflare quick tunnels set this automatically to https://<random>.trycloudflare.com
# AGENTBRIDGE_PUBLIC_ORIGIN=https://agent.example.com

# Optional state location and expiry overrides.
# AGENTBRIDGE_DATA_DIR=D:\agentbridge-data
# AGENTBRIDGE_PAIRING_TTL_MS=120000
# AGENTBRIDGE_SESSION_TTL_MS=86400000

# Optional shared access key for public-exposure modes. When set, every
# non-loopback request must carry it (QR codes embed it automatically).
# The Cloudflare launcher generates and reuses one in .agentbridge/access-key.
# AGENTBRIDGE_ACCESS_KEY=change-me-to-a-long-random-string

# Optional Claude Code model override. By default, the provider's own ANTHROPIC_MODEL is preserved.
# AGENTBRIDGE_CLAUDE_MODEL=kimi-for-coding
# AGENTBRIDGE_CLAUDE_FIRST_OUTPUT_TIMEOUT_MS=30000
