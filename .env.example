# Copy the values you need into the shell that starts AgentBridge.
AGENTBRIDGE_PORT=8787
AGENTBRIDGE_HOST=0.0.0.0
AGENTBRIDGE_MACHINE_NAME=My-PC

# Semicolon-separated alias=absolute-path entries. Phones only see aliases.
AGENTBRIDGE_PROJECTS=agentbridge=D:\codex_project\手机远程操控agent

# Optional. Required for Tailscale/ZeroTier direct mode or when a reverse proxy/HTTPS tunnel is used.
# Tailscale example: http://100.101.102.103:8787
# ZeroTier example:  http://10.147.20.15:8787 (the managed IP shown at my.zerotier.com)
# Cloudflare quick tunnels set this automatically to https://<random>.trycloudflare.com
# AGENTBRIDGE_PUBLIC_ORIGIN=https://agent.example.com

# --- Cross-network path selection (read by both the CLI and the DSH plugin) ---
# Which path the QR code uses. auto tries: named tunnel -> Funnel (only if it is
# already on) -> Cloudflare quick tunnel -> Tailscale -> ZeroTier -> LAN.
# AGENTBRIDGE_REMOTE=auto
# AGENTBRIDGE_NO_TUNNEL=1                             # same as AGENTBRIDGE_REMOTE=lan
# AGENTBRIDGE_TUNNEL_URL=https://fixed.example.com    # you run the tunnel yourself

# Cloudflare named tunnel (needs `cloudflared tunnel create` + a domain on Cloudflare).
# AGENTBRIDGE_CLOUDFLARE_TUNNEL=agentbridge
# AGENTBRIDGE_CLOUDFLARE_HOSTNAME=bridge.example.com

# Private overlays are detected automatically; these only point at unusual installs.
# AGENTBRIDGE_TAILSCALE=C:\Program Files\Tailscale\tailscale.exe
# AGENTBRIDGE_ZEROTIER=10.147.20.15

# cloudflared is located on this machine, and downloaded to <data dir>/bin when
# it is missing.
# AGENTBRIDGE_CLOUDFLARED=D:\tools\cloudflared.exe   # use your own binary; no search, no download
# AGENTBRIDGE_CLOUDFLARED_URL=https://mirror.example.com/cloudflared-windows-amd64.exe
# AGENTBRIDGE_NO_DOWNLOAD=1                          # never fetch cloudflared automatically

# Optional state location and expiry overrides.
# AGENTBRIDGE_DATA_DIR=D:\agentbridge-data
# AGENTBRIDGE_PAIRING_TTL_MS=120000
# AGENTBRIDGE_SESSION_TTL_MS=86400000

# Optional shared access key for public-exposure modes. When set, every
# non-loopback request must carry it (QR codes embed it automatically).
# The Cloudflare launcher generates and reuses one in .agentbridge/access-key.
# AGENTBRIDGE_ACCESS_KEY=change-me-to-a-long-random-string

# Optional Claude Code model override. By default, the provider's own ANTHROPIC_MODEL is preserved.
# AGENTBRIDGE_CLAUDE_MODEL=kimi-for-coding
# AGENTBRIDGE_CLAUDE_FIRST_OUTPUT_TIMEOUT_MS=30000

# Deny an unanswered Claude prompt after this long so the turn continues (default 5 minutes).
# AGENTBRIDGE_CLAUDE_INTERACTION_TIMEOUT_MS=300000

# Optional loopback origin for the CLI and /phone, when the bridge listens on another local port.
# AGENTBRIDGE_LOCAL_ORIGIN=http://127.0.0.1:8787

# Optional push notifications when an agent needs you. Unset leaves the feature inert.
# These may also live in .agentbridge/notify.json, which is git-ignored and survives a
# double-clicked launcher; environment variables win when both exist.
# Formats: json (default) | wecom | telegram | serverchan | pushplus
# AGENTBRIDGE_NOTIFY_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
# AGENTBRIDGE_NOTIFY_FORMAT=wecom
# AGENTBRIDGE_NOTIFY_CHAT_ID=123456789
# AGENTBRIDGE_NOTIFY_TOKEN=your-provider-token
# AGENTBRIDGE_NOTIFY_CHANNEL=clawbot
# AGENTBRIDGE_NOTIFY_LINK=1
