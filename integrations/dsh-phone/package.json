{
  "name": "@chenacc/dsh-agentbridge",
  "version": "0.4.3",
  "description": "AgentBridge for DSH Desktop: run /phone in a conversation to pair a phone console with that exact live Agent.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/icon.png",
    "assets/hero-phone.jpg"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh-desktop",
    "agentbridge",
    "phone",
    "remote-control",
    "qr-pairing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenacc1/agentbridge.git",
    "directory": "integrations/dsh-phone"
  },
  "homepage": "https://github.com/chenacc1/agentbridge/tree/main/integrations/dsh-phone#readme",
  "bugs": {
    "url": "https://github.com/chenacc1/agentbridge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@chenacc/agentbridge": "^0.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
